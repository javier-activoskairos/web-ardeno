# Never commit real secrets; use .env.local locally.

# Public base URL of the site. Used for metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Captación de interés ---------------------------------------------------
# El interruptor maestro. Mientras no sea exactamente "true", /api/interest
# responde `unconfigured` y no reenvía nada, aunque haya webhook configurado.
#
# NO lo enciendas en producción sin política de privacidad aprobada y sin el
# texto o la casilla de consentimiento correspondientes. Ver docs/lead-capture.md.
ARDENO_LEAD_CAPTURE_ENABLED=false

# Webhook de n8n (instancia propia de Ardeno). Sin NEXT_PUBLIC_: se lee en
# servidor y no debe llegar nunca al navegador.
ARDENO_LEAD_WEBHOOK_URL=
ARDENO_LEAD_WEBHOOK_SECRET=
