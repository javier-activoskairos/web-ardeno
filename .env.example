# Never commit real secrets; use .env.local locally.

# --- Entorno de despliegue --------------------------------------------------
# Dónde se está sirviendo esto: local | preview | production
#
# Sin definir se asume `local`, que es el valor seguro. Solo `production` puede
# indexarse: `local` y `preview` devuelven `Disallow: /` en robots.txt, marcan
# la metadata como noindex y añaden `X-Robots-Tag` a todas las respuestas.
#
# Sin prefijo NEXT_PUBLIC_ a propósito: es una decisión de infraestructura y no
# debe llegar al navegador.
ARDENO_DEPLOYMENT_ENV=local

# --- URL pública del sitio --------------------------------------------------
# Base de canonical, Open Graph, sitemap.xml, robots.txt y la validación de
# origen de /api/interest. No es un secreto: es la dirección pública del sitio.
#
# En `local` puede omitirse y se asume http://localhost:3000.
# En `preview` y `production` es OBLIGATORIA, debe ser HTTPS y no puede apuntar
# a la propia máquina. Si falta o es inválida, el build falla con el motivo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Captación de interés ---------------------------------------------------
# El interruptor maestro. Mientras no sea exactamente "true", /api/interest
# responde `unconfigured` y no reenvía nada, aunque haya webhook configurado.
#
# NO lo enciendas en producción sin política de privacidad aprobada y sin el
# texto o la casilla de consentimiento correspondientes. Ver docs/lead-capture.md.
ARDENO_LEAD_CAPTURE_ENABLED=false

# Webhook de n8n (instancia propia de Ardeno). Sin NEXT_PUBLIC_: se lee en
# servidor y no debe llegar nunca al navegador.
ARDENO_LEAD_WEBHOOK_URL=
ARDENO_LEAD_WEBHOOK_SECRET=

# --- Datos legales de la empresa --------------------------------------------
# Los tres son OPCIONALES y hoy están vacíos a propósito: Ardeno todavía no los
# ha confirmado por escrito. Mientras lo estén, /privacy-policy se publica sin
# ellos —no aparece ningún hueco ni ningún «pendiente» en la página— y se
# completa sola en cuanto se definan. No los rellenes por aproximación: es
# información legal. Ver src/lib/legal.ts y docs/privacy-policy.md.
#
# Sin prefijo NEXT_PUBLIC_: los resuelve el servidor al renderizar.

# Razón social inscrita, tal y como deba constar.
ARDENO_LEGAL_ENTITY_NAME=

# Domicilio registral completo, en una línea.
ARDENO_LEGAL_REGISTERED_ADDRESS=

# Fecha de aprobación de la política vigente, YYYY-MM-DD. Si está mal escrita,
# el build falla: una fecha equivocada en un documento legal no puede pasar.
ARDENO_PRIVACY_POLICY_UPDATED_ON=
